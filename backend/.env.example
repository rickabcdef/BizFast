# BizFast 后端环境变量（复制为 .env，切勿提交）
APP_ENV=development
APP_SECRET_KEY=change-me-please

# 关系库（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://bizfast:bizfast@localhost:5432/bizfast

# 缓存 / 队列（Redis）
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE=default

# 对象存储（S3 兼容；本地用 MinIO）
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=bizfast
STORAGE_PUBLIC_BASE=http://localhost:9000/bizfast

# 大模型（主 + 备用，自动降级，M2-08）
AI_PRIMARY_BASE=https://api.openai.com/v1
AI_PRIMARY_KEY=sk-xxx
AI_PRIMARY_MODEL=gpt-4o
AI_BACKUP_BASE=https://api.another-provider.com/v1
AI_BACKUP_KEY=xxx
AI_BACKUP_MODEL=xxx

# 支付（各渠道，按端适配 M5-04）
WECHAT_MCH_ID=
WECHAT_API_KEY=
ALIPAY_APP_ID=
APPLE_SHARED_SECRET=
HUAWEI_APP_ID=

# 合规：不在服务端存储用户输入原文（M6-04）
RETENTION_KEEP_USER_INPUT=false

# ================= 本地调试降级开关（生产保持默认即可） =================
# 无 Docker / 无 PostgreSQL 时，用 SQLite 跑通网页版全链路：
#   DATABASE_URL=sqlite+aiosqlite:///./var/bizfast.db
# 队列后端：auto（有 REDIS_URL 用 RQ，否则进程内）/ rq / inline
QUEUE_BACKEND=auto
# 存储后端：auto（有 STORAGE_ENDPOINT 用 S3，否则本地磁盘）/ s3 / local
STORAGE_BACKEND=auto
LOCAL_STORAGE_DIR=var/storage
LOCAL_STORAGE_BASE_URL=/api/files

# 未接真实支付渠道时走本地模拟支付（仅本地联调；生产置 false 并补齐渠道密钥）
PAYMENT_MOCK=true

# 诊断阶段最低展示时长（毫秒）：仅用于进度条平滑推进的 UX 节奏，进度百分比本身真实
DIAGNOSE_STAGE_MIN_MS=450
# 强制走本地规则引擎（跳过所有大模型调用），用于离线自测
DIAGNOSE_MOCK_AI=false

